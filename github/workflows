name: Auto Ingest Data Midnight

on:
  schedule:
    - cron: '0 17 * * *'
  workflow_dispatch: 

jobs:
  run-ingestion:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout code dữ liệu
        uses: actions/checkout@v3

      - name: Cài đặt Python
        uses: actions/setup-python@v4
        with:
          python-version: '3.10'

      - name: Cài đặt các thư viện cần thiết
        run: |
          pip install -r requirements.txt

      - name: Chạy script lấy dữ liệu
        env:
          # Các biến bảo mật này bạn sẽ cài đặt trong phần Settings > Secrets của Repo GitHub
          KAGGLE_USERNAME: ${{ secrets.KAGGLE_USERNAME }}
          KAGGLE_KEY: ${{ secrets.KAGGLE_KEY }}
          MOTHERDUCK_TOKEN: ${{ secrets.MOTHERDUCK_TOKEN }}
        run: python data_ingestion/ingest.py